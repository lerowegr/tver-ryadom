# Окружение: development | production | test
ENVIRONMENT=development

# База. В docker compose хост — имя службы, не localhost.
DATABASE_URL=postgresql+asyncpg://tver:tver@localhost:5432/tver
DATABASE_ECHO=false

# Подпись токенов. В проде — длинная случайная строка, не это значение.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Через запятую. Без этого браузер не пустит сайт к API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SITE_URL=http://localhost:3000
# На своём домене хватает lax; none нужен был на *.workers.dev.
COOKIE_SAMESITE=lax

# Фотографии остаются в Cloudflare R2 — у него S3-совместимый API.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tver-images
IMAGES_BASE_URL=

# Каналы. Пустое значение выключает канал.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
VK_GROUP_TOKEN=
VK_CONFIRMATION=
VK_SECRET=
MAX_BOT_TOKEN=
MAX_API_BASE=
RESEND_API_KEY=
EMAIL_FROM=
