{
  "name": "@tver/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Административная панель «Тверь рядом» (Next.js на Cloudflare Workers)",
  "scripts": {
    "dev": "node ../../scripts/copy-map-worker.mjs && next dev --port 3001",
    "build": "node ../../scripts/copy-map-worker.mjs && next build",
    "build:worker": "node ../../scripts/copy-map-worker.mjs && opennextjs-cloudflare build",
    "deploy": "node ../../scripts/copy-map-worker.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tver/shared": "workspace:*",
    "maplibre-gl": "^6.6.0",
    "next": "^15.5.27",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260711.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tver/config": "workspace:*",
    "@types/node": "20.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "wrangler": "^4.110.0"
  }
}
