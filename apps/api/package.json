{
  "name": "@tver/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "REST API, Telegram-бот и cron-джобы (Hono на Cloudflare Workers)",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "admin:password": "node ../../scripts/set-admin-password.mjs",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tver/db": "workspace:*",
    "@tver/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@tver/config": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.147.0"
  }
}
