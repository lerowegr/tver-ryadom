{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tver-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tver-ryadom",
      "database_id": "806a6e75-8ce1-4129-a0e7-a0dd67c65af8",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "tver-images"
    }
  ],
  // Продакшен-значения; для локальной разработки переопределяются в .dev.vars.
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGINS": "https://tver-web.tver-ryadom.workers.dev,https://tver-admin.tver-ryadom.workers.dev",
    "IMAGES_BASE_URL": "https://tver-api.tver-ryadom.workers.dev/images",
    "SITE_URL": "https://tver-web.tver-ryadom.workers.dev",
    // На *.workers.dev поддомены — разные сайты (PSL); со своим доменом сменить на "lax".
    "COOKIE_SAMESITE": "none"
  },
  "triggers": {
    // Каждую минуту: доставка outbox-уведомлений и напоминания за сутки.
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
